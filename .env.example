# =====================================================
# dev-stub — shared environment configuration
# =====================================================
# Copy this file to `.env` and adjust as needed.
#
# Each stub uses a distinct namespace prefix:
#   FEEE_*  → feee  (Feee.io mock)
#   ...     → future stubs

# ----- Feee.io stub (stubs/feee/) -----
FEEE_PORT=3080
FEEE_API_KEY=test-key-123
FEEE_PLATFORM_BALANCE=100
FEEE_ENERGY_USED=48000
FEEE_DELEGATION_DELAY_MS=3000
FEEE_ORDER_PREFIX=mock-

# ----- Future stubs -----
# MY_STUB_PORT=3090
# MY_STUB_API_KEY=test-key-123
