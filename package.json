{
  "name": "dev-stub",
  "version": "0.1.0",
  "private": true,
  "description": "Modular stub/mock server for A-Bot development and testing — each stub lives in stubs/<name>/",
  "scripts": {
    "feee": "node stubs/feee/index.js",
    "feee:dev": "node --watch stubs/feee/index.js",
    "test:feee": "node tests/feee/smoke.test.js",
    "test:feee:integration": "node tests/feee/integration/backend-client.test.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "_moduleAliases": {
    "@dev-stub": ".",
    "@dev-stub/lib": "lib",
    "@dev-stub/env": "lib/env.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "module-alias": "^2.2.3",
    "uuid": "^9.0.1"
  }
}
